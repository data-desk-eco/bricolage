#!/bin/sh
# macos: write only the scratch directory, read anything but the home directory beyond it, network open
exec sandbox-exec -p "(version 1) (allow default) (deny file-write*) (deny file-read* (subpath \"$HOME\")) (allow file-read* file-write* (subpath \"$(pwd -P)\")) (allow file-write* (subpath \"/dev\"))" sh "$1"
