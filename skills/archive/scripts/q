#!/bin/sh
# q "select ..." — one csv query against the archive; builds archive.db on first use
db=${ARCHIVE_DB:-archive.db}
# a database older than this script holds old macros: build it again
[ "$db" -nt "$0" ] || { rm -f "$db"; duckdb "$db" "
install httpfs; install spatial;
create macro bucket(p) as 'https://s3.WAW3-2.cloudferro.com/data-desk-archive/' || p;
create macro plumes() as table select id, provider as src, lat, lon, date as dt, rate_kg_h as rate, rate_std_kg_h as unc, satellite as sat, link, overlay, bounds from read_parquet(list_transform(['carbon-mapper', 'imeo', 'sron', 'data-desk'], lambda p: bucket(p || '/detections/data.parquet')), union_by_name = true) where kind = 'plume' and valid;
create macro features() as table select id, provider as dataset, kind, name, operator, status, fuel, lat, lon, geometry from read_parquet(list_transform(['ogim', 'osm', 'gem', 'mapstand', 'netl'], lambda p: bucket(p || '/infrastructure/data.parquet')), union_by_name = true);
create macro attributions() as table select * from read_parquet(bucket('data-desk/attributions/data.parquet'));
create macro entities() as table select * from read_parquet(bucket('gem/source/entities.parquet'));
create macro owners() as table select * from read_parquet(bucket('gem/source/ownership.parquet'));
create macro gleif() as table select * from read_parquet(bucket('gleif/source/data.parquet'));
create macro flares() as table select id, lat, lon, cell, country, detail, first_seen, last_seen, detections, observations, flags from read_parquet(bucket('eog/flares/data.parquet'));
create macro nightfire(id0, cell0) as table select date, satellite, rh_mw, temp_k from read_parquet(bucket('eog/detections/cell=' || cell0 || '/data.parquet')) where site_id = id0 and valid order by date;
create macro detections(tile) as table select * from read_parquet(bucket('views/detections/mgrs=' || tile || '/data.parquet'));
create macro near(lat0, lon0, km) as table
  select *, 111.2 * sqrt(((lat - lat0)) ^ 2 + ((lon - lon0) * cos(radians(lat0))) ^ 2) as km
  from features()
  where lat between lat0 - km / 111.2 and lat0 + km / 111.2
    and lon between lon0 - km / (111.2 * cos(radians(lat0))) and lon0 + km / (111.2 * cos(radians(lat0)));
" || { rm -f "$db"; exit 1; }; }
exec duckdb -csv -cmd 'load httpfs; load spatial;' "$db" "$1"
