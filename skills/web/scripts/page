#!/bin/sh
# page URL [markdown|text|links|html|shot] — one web page read through a
# browser, or a pdf's text; shot prints a png. every read is kept in
# bric_fetch, so a row cites the url and the output can be piped at will.
case ${2:-markdown}$1 in
  shot*) exec obscura fetch "$1" --screenshot /dev/stdout --quiet ;;
  *.pdf|*.pdf\?*) t=$(curl -sfL "$1" | pdftotext -layout - -) ;;
  *) t=$(obscura fetch "$1" --dump "${2:-markdown}" --quiet) ;;
esac || { printf '%s\n%s\n' "$1" "$t"; exit 1; }
e() { printf %s "$1" | sed -E "s/'/''/g; s/\]\([^)]*\)/]/g"; }
[ -z "$t" ] || printf "insert into bric_fetch (url, text) values ('%s', \
squeeze('%s'))" "$(e "$1")" "$(e "$t")" | db >/dev/null 2>&1 || :
printf '%s\n%s\n' "$1" "$t"
